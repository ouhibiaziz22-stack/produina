NODE_ENV=development
PORT=5000
# Supabase → Project Settings → API. The secret key is server-only; never put it in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=product-images
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated storefront origins allowed by CORS (localhost is allowed automatically outside production)
FRONTEND_URL=http://localhost:8080
# Number of proxies in front of the API (1 on Render/Railway)
TRUST_PROXY=1
# Optional: creates or promotes this administrator at startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Prodwina Admin
FEATURE_BAC=true
